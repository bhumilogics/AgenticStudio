# Copy to .env and fill in what you need. Anything left unset just means
# the tool/feature it gates is skipped, not that anything crashes.

# --- LLM backend ---
# Default here is claude-code: NO Anthropic API key needed at all, the
# planner runs through your Claude Pro/Max subscription via the Claude
# Code CLI (`claude login` once, see project README). Set both of these
# to "api" instead if you get an ANTHROPIC_API_KEY and want the more
# reliable native structured tool-calling that only the API gives you.
AGENTICSTUDIO_LLM_BACKEND=claude-code        # api | claude-code
AGENTICSTUDIO_REFLECTOR_BACKEND=heuristic    # heuristic | api | claude-code
AGENTICSTUDIO_CLAUDE_CODE_BIN=claude         # binary name or full path
AGENTICSTUDIO_CLAUDE_CODE_MODEL=             # blank = claude CLI's own default
AGENTICSTUDIO_CLAUDE_CODE_TIMEOUT=90

# Only needed if AGENTICSTUDIO_LLM_BACKEND=api or AGENTICSTUDIO_REFLECTOR_BACKEND=api
ANTHROPIC_API_KEY=

# --- Core ---
AGENTICSTUDIO_MODEL=claude-sonnet-5
AGENTICSTUDIO_TEMPERATURE=0
AGENTICSTUDIO_MAX_TOKENS=4096
AGENTICSTUDIO_AUTONOMY=checkpoint          # autonomous | checkpoint | supervised
AGENTICSTUDIO_RISKY_TOOLS=shell_exec,python_repl,python_ast_repl,send_gmail_message,requests_post,requests_patch,requests_put,requests_delete,file_delete,move_file,aws_lambda
AGENTICSTUDIO_MAX_ITERATIONS=25
AGENTICSTUDIO_MAX_TOOL_RETRIES=2
AGENTICSTUDIO_TOOL_CATEGORIES=              # comma-separated to restrict, blank = all available

# --- Persistence ---
AGENTICSTUDIO_CHECKPOINT_DB=./data/checkpoints.sqlite
AGENTICSTUDIO_EVENTS_DB=./data/events.sqlite

# --- Observability ---
AGENTICSTUDIO_LOG_LEVEL=INFO
AGENTICSTUDIO_LOG_JSON=true
AGENTICSTUDIO_LOG_DIR=./data/logs

# --- tools/code_execution.py ---
AGENTICSTUDIO_ALLOW_UNSANDBOXED_EXEC=0     # 1 = allow raw ShellTool/PythonREPLTool (dev only!)
BEARLY_API_KEY=
E2B_API_KEY=

# --- tools/file_ops.py ---
AGENTICSTUDIO_WORKDIR=./workdir

# --- tools/data_db.py ---
AGENTICSTUDIO_DB_URI=
AGENTICSTUDIO_ALLOW_HTTP_REQUESTS=0
AGENTICSTUDIO_OPENAPI_SPEC=
AGENTICSTUDIO_JSON_FILE=
AGENTICSTUDIO_CSV_FILE=

# --- tools/search_web.py ---
TAVILY_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
BING_SUBSCRIPTION_KEY=
BING_SEARCH_URL=
SEARX_HOST=
BRAVE_API_KEY=

# --- tools/productivity.py ---
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=token.json
SLACK_USER_TOKEN=
GITHUB_APP_ID=
GITHUB_REPOSITORY=
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_REPOSITORY=
JIRA_API_TOKEN=
JIRA_USERNAME=
JIRA_INSTANCE_URL=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
ZAPIER_NLA_API_KEY=

# --- tools/cloud_infra.py ---
AGENTICSTUDIO_LAMBDA_FUNCTION_NAME=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AGENTICSTUDIO_ENABLE_BROWSER=0

# --- tools/retrieval.py ---
AGENTICSTUDIO_EMBEDDINGS=local             # local | openai | voyage
AGENTICSTUDIO_MEMORY_DIR=./memory/chroma
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- tools/math_utils.py ---
WOLFRAM_ALPHA_APPID=

# --- tools/multimodal.py ---
AZURE_COGS_KEY=
AZURE_COGS_ENDPOINT=
